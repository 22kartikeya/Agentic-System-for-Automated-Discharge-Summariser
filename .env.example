# Environment template — copy to .env and fill values. Never commit .env.

# A2A shared secret (header: X-Agent-Auth-Token)
AGENT_AUTH_TOKEN=change-me-local-dev-token

# AWS Bedrock (Nova Lite primary via LiteLLM / langchain-aws)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
BEDROCK_PRIMARY_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=cohere.command-r-plus-v1:0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-english-v3
BEDROCK_MAX_TOKENS=500

# Cohere (Command R+ fallback)
COHERE_API_KEY=

# OCR (optional — Harvester tool falls back to a text notice when false)
TESSERACT_ENABLED=false

# LangFuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Optional local / lab
OLLAMA_HOST=http://127.0.0.1:11434
